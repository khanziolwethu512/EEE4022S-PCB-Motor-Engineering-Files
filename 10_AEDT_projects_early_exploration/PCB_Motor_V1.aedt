					VariablePropNU('Td', 'D', 'Initial delay time, leaving empty in Unit. Value is in seconds if Type is TIME, in deg if Type is POS.', '0', '', AdditionalPropInfo='')
					VariablePropNU('Tr', 'D', 'Rise time, leaving empty in Unit. Value is in seconds if Type is TIME, in deg if Type is POS.', '0.1', '', AdditionalPropInfo='')
					VariablePropNU('Tf', 'D', 'Fall time, leaving empty in Unit. Value is in seconds if Type is TIME, in deg if Type is POS.', '0.1', '', AdditionalPropInfo='')
					VariablePropNU('Pw', 'D', 'Pulse width, leaving empty in Unit. Value is in seconds if Type is TIME, in deg if Type is POS.', '0.5', '', AdditionalPropInfo='')
					VariablePropNU('Period', 'D', 'Pulse period, leaving empty in Unit. Value is in seconds if Type is TIME, in deg if Type is POS.', '1', '', AdditionalPropInfo='')
